<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>fpsfix</AssemblyName>
    <RootNamespace>JimengFpsFix</RootNamespace>
    <Version>1.0.0</Version>
    <Product>帧率修复工具 命令行版</Product>
    <CodePage>65001</CodePage>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PackAsTool>false</PackAsTool>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Ff.cs" />
    <Compile Include="..\Repair.cs" />
    <Compile Include="..\FfLocator.cs" />
    <Compile Include="..\AppSettings.cs" />
    <Compile Include="..\CliRunner.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

</Project>
