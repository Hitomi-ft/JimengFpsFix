<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>JimengFpsFix</AssemblyName>
    <RootNamespace>JimengFpsFix</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>帧率修复工具 (FpsFix)</Product>
    <AssemblyTitle>帧率修复工具</AssemblyTitle>
    <Description>把 24.08 帧等异常帧率修复为精确 CFR 帧率，并保持音频对齐</Description>
    <CodePage>65001</CodePage>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- the console-mode project lives in src/cli and has its own entry point -->
    <Compile Remove="cli\**" />
    <None Remove="cli\**" />
  </ItemGroup>

</Project>
